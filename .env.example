# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# BSA Online Credentials (will be encrypted)
BSA_USERNAME=your_username
BSA_PASSWORD=your_password

# Encryption key for storing credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# BSA Configuration
BSA_MUNICIPALITY_UID=305

# Scraping settings
SCRAPE_INTERVAL_HOURS=24
HEADLESS_BROWSER=true

# =============================================================================
# Web Application Configuration
# =============================================================================

# Web App Settings
WEB_SECRET_KEY=your-secret-key-here  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=false

# Twilio SMS (optional - for SMS notifications)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email (optional - for email notifications)
SENDGRID_API_KEY=your_api_key
EMAIL_FROM=noreply@yourdomain.com

# SMTP Email (alternative to SendGrid)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_USE_TLS=true

# =============================================================================
# TenantReportX Screening
# =============================================================================
# Sign up at https://tenantreportx.com for API access
# Screening is optional — applications still work without it
TENANTREPORTX_API_URL=https://api.tenantreportx.com
TENANTREPORTX_API_KEY=your_api_key
TENANTREPORTX_ACCOUNT_ID=your_account_id
TENANTREPORTX_WEBHOOK_SECRET=your_webhook_secret
TENANTREPORTX_APPLICANT_FEE=25.00

# =============================================================================
# DocuSign E-Sign Configuration
# =============================================================================
# 1. Create app at https://developers.docusign.com
# 2. Generate RSA keypair in the app settings
# 3. Grant consent: https://account-d.docusign.com/oauth/auth?response_type=code&scope=signature%20impersonation&client_id=YOUR_INTEGRATION_KEY&redirect_uri=http://localhost
# For production: change demo URLs to production URLs
DOCUSIGN_INTEGRATION_KEY=your-integration-key
DOCUSIGN_USER_ID=your-user-guid
DOCUSIGN_ACCOUNT_ID=your-account-id
DOCUSIGN_PRIVATE_KEY_PATH=./docusign_private.key
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_URL=https://account-d.docusign.com
